# 이 파일을 .env로 복사한 뒤 비밀번호를 채운다. .env는 커밋하지 않는다.
#   Copy-Item .env.example .env

# docker-compose.yml의 로컬 PostgreSQL 계정
POSTGRES_USER=pickcast
POSTGRES_PASSWORD=
POSTGRES_DB=pickcast

# 백엔드 접속 주소. 위 계정과 맞춘다. 배포할 때는 플랫폼 환경변수로 넣는다.
# localhost 대신 127.0.0.1을 쓴다. DB 포트를 127.0.0.1에만 열어서 localhost(IPv6)로는 접속이 몇 초씩 늦어진다.
DATABASE_URL=postgresql+psycopg://pickcast:<POSTGRES_PASSWORD>@127.0.0.1:15432/pickcast
